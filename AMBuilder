import os

for sdk_target in MMSPlugin.sdk_targets:
  sdk = sdk_target.sdk
  cxx = sdk_target.cxx

  binary = MMSPlugin.HL2Library(builder, cxx, f'{MMSPlugin.metadata["name"]}.{sdk["name"]}', sdk)

  if binary.compiler.target.platform == 'windows':
    binary.compiler.postlink += [
      os.path.join(sdk['path'], 'lib', 'public', 'win64', 'steam_api64.lib'),
    ]
  elif binary.compiler.target.platform == 'linux':
    binary.compiler.postlink += [
      os.path.join(sdk['path'], 'lib', 'linux64', 'libsteam_api.so'),
    ]

  generated_folder = builder.AddFolder('generated')
  generated = sdk_target.protoc.Generate(
    builder,
    [os.path.join(sdk['path'], 'common', 'network_connection.proto')],
    [('cpp', generated_folder)],
  )
  binary.compiler.sourcedeps += generated['cpp']['headers']
  binary.compiler.cxxincludes += [os.path.join(builder.buildPath, 'generated')]

  binary.sources += [
    'src/plugin.cpp',
    'src/faceit_parser.cpp',
  ]

  nodes = builder.Add(binary)
  MMSPlugin.binaries += [nodes]
